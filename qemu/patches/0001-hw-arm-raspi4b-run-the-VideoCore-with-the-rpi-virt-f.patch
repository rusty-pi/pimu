+        object_property_set_uint(OBJECT(soc), "enabled-cpus", 0,
+                                 &error_abort);
+    }
     qdev_realize(DEVICE(soc), NULL, &error_fatal);
 
     /* Create and plug in the SD cards */
@@ -298,6 +302,14 @@ void raspi_base_machine_init(MachineState *machine,
     }
     boot_ram_size = MIN(vcram_base, UPPER_RAM_BASE - vcram_size);
 
+    if (RASPI_BASE_MACHINE(machine)->firmware_boots_arm) {
+        if (machine->kernel_filename || machine->firmware) {
+            error_report("-kernel/-bios are not used with videocore=: "
+                         "the firmware loads the ARM from the SD card");
+            exit(1);
+        }
+        return;
+    }
     setup_boot(machine, &soc->cpu[0].core, board_processor_id(board_rev),
                boot_ram_size);
 }
