diff --git a/hw/misc/rvf_videocore.c b/hw/misc/rvf_videocore.c
new file mode 100644
index 0000000..be0a373
--- /dev/null
+++ b/hw/misc/rvf_videocore.c
@@ -0,0 +1,434 @@
+/*
+ * The Raspberry Pi 4 VideoCore, run by the rpi-virt-fw firmware model.
+ *
+ * The BCM2711 has two processors: four Cortex-A72s, which QEMU's raspi4b
+ * emulates, and the VideoCore IV VPU that runs the boot firmware
+ * (pieeprom.bin, start4.elf) and stays resident as the ARM's firmware
+ * service. This device is that second processor. It links the rpi-virt-fw
+ * model (https://github.com/valtzu/rpi-virt-fw) as a library and runs it on
+ * its own thread over guest RAM, so the firmware loads the ARM stub, kernel
+ * and device tree into the same memory the ARM cores boot from, releases the
+ * cores out of reset the way the hardware does, and then answers the
+ * mailbox requests Linux sends it.
+ *
+ * Locking: the model is not thread-safe, so the VPU thread takes the BQL for
+ * every slice it runs. The ARM's MMIO into the model already runs under the
+ * BQL on a vCPU thread, which is what makes the two mutually exclusive
+ * without a second lock (and lets the model reach QEMU's own devices, and
+ * raise interrupts, from inside a slice).
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "qemu/error-report.h"
+#include "qemu/log.h"
+#include "qemu/main-loop.h"
+#include "qemu/module.h"
+#include "qemu/rcu.h"
+#include "qemu/timer.h"
+#include "hw/irq.h"
+#include "hw/qdev-properties.h"
+#include "hw/misc/rvf_videocore.h"
+#include "system/address-spaces.h"
+#include "system/memory.h"
+#include "system/runstate.h"
+#include "hw/core/cpu.h"
+#include "target/arm/arm-powerctl.h"
+
+#include <rvf.h>
+
+/* The ARM's mailbox aperture, in VideoCore bus addresses. */
+#define RVF_MBOX_BASE   0x7e00b880
+#define RVF_MBOX_SIZE   0x40
+/* UART0 (PL011): shared with the ARM, so the firmware drives QEMU's. */
+#define RVF_UART0_BASE  0x7e201000
+#define RVF_UART0_SIZE  0x200
+
+/* How far the model may run ahead of the virtual clock before it sleeps. */
+#define RVF_PACE_SLACK_NS   (1 * SCALE_MS)
+#define RVF_PACE_NAP_NS     (2 * SCALE_MS)
+
+static void rvf_update_irq(RvfVideoCoreState *s)
+{
+    int level = rvf_vc_arm_irq(s->vc);
+
+    if (level != s->irq_level) {
+        s->irq_level = level;
+        qemu_set_irq(s->mbox_irq, level);
+    }
+}
+
+/* --- callbacks from the model (BQL held: we are inside a slice) --------- */
+
+static uint32_t rvf_cb_mmio_read(void *opaque, uint32_t addr, uint32_t size)
+{
+    RvfVideoCoreState *s = opaque;
+    uint32_t value = 0;
+
+    address_space_rw(&s->gpu_as, addr, MEMTXATTRS_UNSPECIFIED,
+                     &value, size, false);
+    return le32_to_cpu(value);
+}
+
+static void rvf_cb_mmio_write(void *opaque, uint32_t addr, uint32_t size,
+                              uint32_t value)
+{
+    RvfVideoCoreState *s = opaque;
+    uint32_t le = cpu_to_le32(value);
+
+    address_space_rw(&s->gpu_as, addr, MEMTXATTRS_UNSPECIFIED,
+                     &le, size, true);
+}
+
+static void rvf_cb_console(void *opaque, const uint8_t *buf, size_t len)
+{
+    /* Debug path (uart=model): the model kept its own UART; dump it here. */
+    fwrite(buf, 1, len, stderr);
+    fflush(stderr);
+}
+
+static void rvf_cb_log(void *opaque, const char *msg)
+{
+    qemu_log_mask(LOG_GUEST_ERROR, "rvf-videocore: %s\n", msg);
+    info_report("rvf-videocore: %s", msg);
+}
+
+static void rvf_cb_arm_release(void *opaque)
+{
+    RvfVideoCoreState *s = opaque;
+    CPUState *cs;
+
+    /*
+     * The hand-off. Every core comes out of reset at physical 0 in EL3 —
+     * whatever the firmware put there (armstub8, or RPI_EFI.fd's TF-A)
+     * parks the secondaries itself, exactly as on the board.
+     */
+    CPU_FOREACH(cs) {
+        uint64_t mpidr = object_property_get_uint(OBJECT(cs), "mp-affinity",
+                                                  &error_abort);
+        int r = arm_set_cpu_on(mpidr, 0, 0, 3, true);
+
+        if (r != QEMU_ARM_POWERCTL_RET_SUCCESS) {
+            warn_report("rvf-videocore: cannot start cpu %" PRIx64 ": %d",
+                        mpidr, r);
+        }
+    }
+    s->pace_offset_ns = (int64_t)rvf_vc_now_us(s->vc) * SCALE_US
+                        - qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    s->released = true;
+}
+
+/* --- the ARM's view --------------------------------------------------- */
+
+static uint64_t rvf_mbox_read(void *opaque, hwaddr offset, unsigned size)
+{
+    RvfVideoCoreState *s = opaque;
+    uint32_t v = rvf_vc_mmio_read(s->vc, RVF_MBOX_BASE + offset, size);
+
+    rvf_update_irq(s);
+    return v;
+}
+
+static void rvf_mbox_write(void *opaque, hwaddr offset, uint64_t value,
+                           unsigned size)
+{
+    RvfVideoCoreState *s = opaque;
+
+    rvf_vc_mmio_write(s->vc, RVF_MBOX_BASE + offset, size, value);
+    rvf_update_irq(s);
+}
+
+/* --- everything QEMU has no device for --------------------------------- */
+
+/* VideoCore bus bases of the two peripheral windows the ARM sees. */
+#define RVF_VC_PERI_BASE        0x7e000000
+#define RVF_VC_PERI_LOW_BASE    0x7c000000
+
+static uint64_t rvf_fallback_read(RvfVideoCoreState *s, uint32_t vc_base,
+                                  hwaddr offset, unsigned size)
+{
+    uint32_t v = rvf_vc_mmio_read(s->vc, vc_base + offset, size);
+
+    rvf_update_irq(s);
+    return v;
+}
+
+static void rvf_fallback_write(RvfVideoCoreState *s, uint32_t vc_base,
+                               hwaddr offset, uint64_t value, unsigned size)
+{
+    rvf_vc_mmio_write(s->vc, vc_base + offset, size, value);
+    rvf_update_irq(s);
+}
+
+static uint64_t rvf_peri_read(void *opaque, hwaddr offset, unsigned size)
+{
+    return rvf_fallback_read(opaque, RVF_VC_PERI_BASE, offset, size);
+}
+
+static void rvf_peri_write(void *opaque, hwaddr offset, uint64_t value,
+                           unsigned size)
+{
+    rvf_fallback_write(opaque, RVF_VC_PERI_BASE, offset, value, size);
+}
+
+static uint64_t rvf_peri_low_read(void *opaque, hwaddr offset, unsigned size)
+{
+    return rvf_fallback_read(opaque, RVF_VC_PERI_LOW_BASE, offset, size);
+}
+
+static void rvf_peri_low_write(void *opaque, hwaddr offset, uint64_t value,
+                               unsigned size)
+{
+    rvf_fallback_write(opaque, RVF_VC_PERI_LOW_BASE, offset, value, size);
+}
+
+static const MemoryRegionOps rvf_peri_ops = {
+    .read = rvf_peri_read,
+    .write = rvf_peri_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid.min_access_size = 1,
+    .valid.max_access_size = 4,
+};
+
+static const MemoryRegionOps rvf_peri_low_ops = {
+    .read = rvf_peri_low_read,
+    .write = rvf_peri_low_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid.min_access_size = 1,
+    .valid.max_access_size = 4,
+};
+
+static const MemoryRegionOps rvf_mbox_ops = {
+    .read = rvf_mbox_read,
+    .write = rvf_mbox_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid.min_access_size = 4,
+    .valid.max_access_size = 4,
+};
+
+/* --- the VPU thread --------------------------------------------------- */
+
+static void rvf_pace(RvfVideoCoreState *s)
+{
+    int64_t model_ns, ahead;
+
+    if (!s->released) {
+        return;
+    }
+    model_ns = (int64_t)rvf_vc_now_us(s->vc) * SCALE_US - s->pace_offset_ns;
+    ahead = model_ns - qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    if (ahead > RVF_PACE_SLACK_NS) {
+        g_usleep(MIN(ahead, RVF_PACE_NAP_NS) / SCALE_US);
+    }
+}
+
+/*
+ * What the boot ROM leaves behind before the EEPROM bootloader runs, as far
+ * as the shared devices are concerned. The bootloader reads the PL011's CR
+ * before its first byte and stays silent while UARTEN is clear, and on the
+ * board it is set at that point (the reference log starts at 0.00 s). QEMU
+ * resets the PL011 to CR=0x300, so this is the ROM's UART enable: 8N1 with
+ * the FIFOs on, UART/TX/RX enabled — the values the model's own PL011 resets
+ * to, and what the bootloader reads back on the board.
+ */
+static void rvf_boot_rom_setup(RvfVideoCoreState *s)
+{
+    rvf_cb_mmio_write(s, RVF_UART0_BASE + 0x2c, 4, 0x70);  /* LCRH: 8N1, FEN */
+    rvf_cb_mmio_write(s, RVF_UART0_BASE + 0x30, 4, 0x301); /* CR: UARTEN|TXE|RXE */
+}
+
+static void *rvf_thread_fn(void *opaque)
+{
+    RvfVideoCoreState *s = opaque;
+    bool first = true;
+
+    rcu_register_thread();
+    while (!s->stop) {
+        int st;
+
+        if (!runstate_is_running()) {
+            g_usleep(1000);
+            continue;
+        }
+        int64_t t0 = qemu_clock_get_ns(QEMU_CLOCK_REALTIME), held;
+
+        bql_lock();
+        if (first) {
+            /* After the machine reset that precedes the first run. */
+            rvf_boot_rom_setup(s);
+            first = false;
+        }
+        st = rvf_vc_run(s->vc, s->slice);
+        rvf_update_irq(s);
+        bql_unlock();
+        held = qemu_clock_get_ns(QEMU_CLOCK_REALTIME) - t0;
+        /*
+         * The BQL is not fair: re-taking it straight away starves every
+         * vCPU that needs it for an MMIO access or an interrupt, and the
+         * guest crawls. Give back at least as long as the slice took, so
+         * the VideoCore never holds the lock for more than half the time.
+         */
+        if (s->released && held > 0) {
+            g_usleep(MAX(held / SCALE_US, 20));
+        }
+
+        if (st == RVF_RUN_RESET) {
+            warn_report("rvf-videocore: the firmware requested a SoC reset; "
+                        "resetting the machine is not modelled yet, the "
+                        "VideoCore is now stopped");
+            break;
+        }
+        if (st != RVF_RUN_RUNNING) {
+            break;
+        }
+        rvf_pace(s);
+    }
+    rcu_unregister_thread();
+    return NULL;
+}
+
+/* --- device ----------------------------------------------------------- */
+
+static bool rvf_read_file(const char *path, uint8_t **out, size_t *len,
+                          Error **errp)
+{
+    gchar *data = NULL;
+    gsize n = 0;
+    GError *gerr = NULL;
+
+    if (!g_file_get_contents(path, &data, &n, &gerr)) {
+        error_setg(errp, "rvf-videocore: %s: %s", path, gerr->message);
+        g_error_free(gerr);
+        return false;
+    }
+    *out = (uint8_t *)data;
+    *len = n;
+    return true;
+}
+
+static void rvf_videocore_realize(DeviceState *dev, Error **errp)
+{
+    RvfVideoCoreState *s = RVF_VIDEOCORE(dev);
+    g_autofree uint8_t *eeprom = NULL;
+    g_autofree uint8_t *sd = NULL;
+    size_t eeprom_len = 0, sd_len = 0;
+    char err[256] = "";
+    rvf_host_ops ops = {
+        .opaque = s,
+        .mmio_read = rvf_cb_mmio_read,
+        .mmio_write = rvf_cb_mmio_write,
+        .console = rvf_cb_console,
+        .log = rvf_cb_log,
+        .arm_release = rvf_cb_arm_release,
+    };
+
+    if (!s->eeprom) {
+        error_setg(errp, "rvf-videocore: the 'eeprom' property is required");
+        return;
+    }
+    if (!s->ram || !s->gpu_bus) {
+        error_setg(errp, "rvf-videocore: 'ram' and 'gpu-bus' links required");
+        return;
+    }
+    if (!rvf_read_file(s->eeprom, &eeprom, &eeprom_len, errp)) {
+        return;
+    }
+    if (s->sd && !rvf_read_file(s->sd, &sd, &sd_len, errp)) {
+        return;
+    }
+
+    address_space_init(&s->gpu_as, s->gpu_bus, "rvf-videocore-gpu");
+
+    s->vc = rvf_vc_new(memory_region_get_ram_ptr(s->ram),
+                       memory_region_size(s->ram),
+                       eeprom, eeprom_len, sd, sd_len,
+                       &ops, err, sizeof(err));
+    if (!s->vc) {
+        error_setg(errp, "rvf-videocore: %s", err);
+        return;
+    }
+    /*
+     * UART0 is one device on the board, shared by both processors, so the
+     * firmware drives QEMU's PL011 — unless `uart=model` keeps the model's
+     * own UART and dumps it on stderr, which tells the two apart when the
+     * firmware log looks wrong.
+     */
+    if (!s->uart || strcmp(s->uart, "shared") == 0) {
+        rvf_vc_add_foreign(s->vc, RVF_UART0_BASE,
+                           RVF_UART0_BASE + RVF_UART0_SIZE);
+    } else if (strcmp(s->uart, "model") != 0) {
+        error_setg(errp, "rvf-videocore: uart must be 'shared' or 'model'");
+        return;
+    }
+
+    memory_region_init_io(&s->mbox_mr, OBJECT(s), &rvf_mbox_ops, s,
+                          "rvf-videocore-mbox", RVF_MBOX_SIZE);
+    sysbus_init_mmio(SYS_BUS_DEVICE(s), &s->mbox_mr);
+    /* Sized by the SoC's windows: 0x7e000000.. and 0x7c000000.. */
+    memory_region_init_io(&s->peri_fallback_mr, OBJECT(s), &rvf_peri_ops, s,
+                          "rvf-videocore-peri", 0x02000000);
+    sysbus_init_mmio(SYS_BUS_DEVICE(s), &s->peri_fallback_mr);
+    memory_region_init_io(&s->peri_low_fallback_mr, OBJECT(s),
+                          &rvf_peri_low_ops, s, "rvf-videocore-peri-low",
+                          0x02000000);
+    sysbus_init_mmio(SYS_BUS_DEVICE(s), &s->peri_low_fallback_mr);
+    sysbus_init_irq(SYS_BUS_DEVICE(s), &s->mbox_irq);
+
+    qemu_thread_create(&s->thread, "rvf-videocore", rvf_thread_fn, s,
+                       QEMU_THREAD_JOINABLE);
+    s->thread_started = true;
+}
+
+static void rvf_videocore_unrealize(DeviceState *dev)
+{
+    RvfVideoCoreState *s = RVF_VIDEOCORE(dev);
+
+    if (s->thread_started) {
+        s->stop = true;
+        qemu_thread_join(&s->thread);
+        s->thread_started = false;
+    }
+    if (s->vc) {
+        rvf_vc_free(s->vc);
+        s->vc = NULL;
+    }
+}
+
+static const Property rvf_videocore_properties[] = {
+    DEFINE_PROP_STRING("eeprom", RvfVideoCoreState, eeprom),
+    DEFINE_PROP_STRING("sd", RvfVideoCoreState, sd),
+    DEFINE_PROP_STRING("uart", RvfVideoCoreState, uart),
+    /* VPU instructions per BQL slice: ~0.1 ms of model time at 18 MIPS. */
+    DEFINE_PROP_UINT32("slice", RvfVideoCoreState, slice, 2000),
+    DEFINE_PROP_LINK("ram", RvfVideoCoreState, ram,
+                     TYPE_MEMORY_REGION, MemoryRegion *),
+    DEFINE_PROP_LINK("gpu-bus", RvfVideoCoreState, gpu_bus,
+                     TYPE_MEMORY_REGION, MemoryRegion *),
+};
+
+static void rvf_videocore_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+
+    dc->realize = rvf_videocore_realize;
+    dc->unrealize = rvf_videocore_unrealize;
+    device_class_set_props(dc, rvf_videocore_properties);
+    /* It is wired by the SoC, not the command line. */
+    dc->user_creatable = false;
+}
+
+static const TypeInfo rvf_videocore_info = {
+    .name = TYPE_RVF_VIDEOCORE,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(RvfVideoCoreState),
+    .class_init = rvf_videocore_class_init,
+};
+
+static void rvf_videocore_register_types(void)
+{
+    type_register_static(&rvf_videocore_info);
+}
+
+type_init(rvf_videocore_register_types)
