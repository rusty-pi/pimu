diff --git a/hw/arm/bcm2838.c b/hw/arm/bcm2838.c
index 22aa754..b4b1b24 100644
--- a/hw/arm/bcm2838.c
+++ b/hw/arm/bcm2838.c
@@ -60,6 +60,13 @@ static void bcm2838_init(Object *obj)
                               "command-line");
 
     object_initialize_child(obj, "gic", &s->gic, TYPE_ARM_GIC);
+
+#ifdef CONFIG_RVF
+    object_property_add_alias(obj, "videocore-eeprom",
+                              OBJECT(&s->peripherals), "videocore-eeprom");
+    object_property_add_alias(obj, "videocore-sd",
+                              OBJECT(&s->peripherals), "videocore-sd");
+#endif
 }
 
 static void bcm2838_realize(DeviceState *dev, Error **errp)
@@ -124,6 +131,23 @@ static void bcm2838_realize(DeviceState *dev, Error **errp)
         return;
     }
 
+#ifdef CONFIG_RVF
+    /*
+     * The GIC-400 has the security extensions, and the ARM stub the firmware
+     * loads (armstub8 at EL3, or TF-A) relies on them: it puts every
+     * interrupt in group 1 and Linux then drives the non-secure aliases.
+     * Without the extensions those aliases hit the group-0 enables and no
+     * interrupt is ever signalled. QEMU's own -kernel path instead resets
+     * the GIC as if secure firmware had run (irq-reset-nonsecure), and is
+     * left as it is.
+     */
+    if (ps->videocore_eeprom &&
+        !object_property_set_bool(OBJECT(&s->gic), "has-security-extensions",
+                                  true, errp)) {
+        return;
+    }
+#endif
+
     if (!sysbus_realize(SYS_BUS_DEVICE(&s->gic), errp)) {
         return;
     }
@@ -187,6 +211,13 @@ static void bcm2838_realize(DeviceState *dev, Error **errp)
     /* Connect VC mailbox to the interrupt controller */
     sysbus_connect_irq(SYS_BUS_DEVICE(&ps_base->mboxes), 0,
                        qdev_get_gpio_in(gicdev, GIC_SPI_INTERRUPT_MBOX));
+#ifdef CONFIG_RVF
+    /* The live firmware's mailbox replaces the mock's; same interrupt line. */
+    if (ps->videocore) {
+        sysbus_connect_irq(SYS_BUS_DEVICE(ps->videocore), 0,
+                           qdev_get_gpio_in(gicdev, GIC_SPI_INTERRUPT_MBOX));
+    }
+#endif
 
     /* Connect SD host to the interrupt controller */
     sysbus_connect_irq(SYS_BUS_DEVICE(&ps_base->sdhost), 0,
diff --git a/hw/arm/bcm2838_peripherals.c b/hw/arm/bcm2838_peripherals.c
index 812b5b8..52c5e3e 100644
--- a/hw/arm/bcm2838_peripherals.c
+++ b/hw/arm/bcm2838_peripherals.c
@@ -21,6 +21,36 @@
 /* Capabilities for SD controller: no DMA, high-speed, default clocks etc. */
 #define BCM2835_SDHC_CAPAREG 0x52134b4
 
+#ifdef CONFIG_RVF
+static char *bcm2838_get_videocore_eeprom(Object *obj, Error **errp)
+{
+    return g_strdup(BCM2838_PERIPHERALS(obj)->videocore_eeprom);
+}
+
+static void bcm2838_set_videocore_eeprom(Object *obj, const char *value,
+                                         Error **errp)
+{
+    BCM2838PeripheralState *s = BCM2838_PERIPHERALS(obj);
+
+    g_free(s->videocore_eeprom);
+    s->videocore_eeprom = g_strdup(value);
+}
+
+static char *bcm2838_get_videocore_sd(Object *obj, Error **errp)
+{
+    return g_strdup(BCM2838_PERIPHERALS(obj)->videocore_sd);
+}
+
+static void bcm2838_set_videocore_sd(Object *obj, const char *value,
+                                     Error **errp)
+{
+    BCM2838PeripheralState *s = BCM2838_PERIPHERALS(obj);
+
+    g_free(s->videocore_sd);
+    s->videocore_sd = g_strdup(value);
+}
+#endif
+
 static void bcm2838_peripherals_init(Object *obj)
 {
     BCM2838PeripheralState *s = BCM2838_PERIPHERALS(obj);
@@ -57,6 +87,16 @@ static void bcm2838_peripherals_init(Object *obj)
                             TYPE_OR_IRQ);
     object_property_set_int(OBJECT(&s->dma_9_10_irq_orgate), "num-lines", 2,
                             &error_abort);
+
+#ifdef CONFIG_RVF
+    /* VideoCore (rpi-virt-fw): the images it boots from, if any. */
+    object_property_add_str(obj, "videocore-eeprom",
+                            bcm2838_get_videocore_eeprom,
+                            bcm2838_set_videocore_eeprom);
+    object_property_add_str(obj, "videocore-sd",
+                            bcm2838_get_videocore_sd,
+                            bcm2838_set_videocore_sd);
+#endif
 }
 
 static void bcm2838_peripherals_realize(DeviceState *dev, Error **errp)
@@ -194,6 +234,49 @@ static void bcm2838_peripherals_realize(DeviceState *dev, Error **errp)
 
     /* BCM2838 RPiVid ASB must be mapped to prevent kernel crash */
     create_unimp(s_base, &s->asb, "bcm2838-asb", BRDG_OFFSET, 0x24);
+
+#ifdef CONFIG_RVF
+    /*
+     * VideoCore. With an EEPROM image the real firmware runs the VPU side of
+     * the SoC, so its mailbox shadows the bcm2835-mbox/property mocks the
+     * common realize mapped: the ARM's 0x40-byte aperture at 0xb880 goes
+     * over them with a higher priority.
+     */
+    if (s->videocore_eeprom) {
+        Object *ram = object_property_get_link(OBJECT(dev), "ram",
+                                               &error_abort);
+        Object *vc = object_new(TYPE_RVF_VIDEOCORE);
+
+        object_property_add_child(OBJECT(dev), "videocore", vc);
+        object_unref(vc);
+        s->videocore = RVF_VIDEOCORE(vc);
+        object_property_set_str(vc, "eeprom", s->videocore_eeprom,
+                                &error_abort);
+        if (s->videocore_sd) {
+            object_property_set_str(vc, "sd", s->videocore_sd, &error_abort);
+        }
+        object_property_set_link(vc, "ram", ram, &error_abort);
+        object_property_set_link(vc, "gpu-bus", OBJECT(&s_base->gpu_bus_mr),
+                                 &error_abort);
+        if (!sysbus_realize(SYS_BUS_DEVICE(vc), errp)) {
+            return;
+        }
+        memory_region_add_subregion_overlap(
+            &s_base->peri_mr, ARMCTRL_0_SBM_OFFSET + 0x80,
+            sysbus_mmio_get_region(SYS_BUS_DEVICE(vc), 0), 1);
+        /*
+         * Under every QEMU device: what QEMU does not model in either
+         * peripheral window (HDMI, HVS, PCIe, thermal, RNG, ...) is served by
+         * the firmware model instead of faulting the guest.
+         */
+        memory_region_add_subregion_overlap(
+            &s_base->peri_mr, 0,
+            sysbus_mmio_get_region(SYS_BUS_DEVICE(vc), 1), -1);
+        memory_region_add_subregion_overlap(
+            &s->peri_low_mr, 0,
+            sysbus_mmio_get_region(SYS_BUS_DEVICE(vc), 2), -1);
+    }
+#endif
 }
 
 static void bcm2838_peripherals_class_init(ObjectClass *oc, const void *data)
diff --git a/hw/arm/raspi.c b/hw/arm/raspi.c
index 81d2fa1..60134ff 100644
--- a/hw/arm/raspi.c
+++ b/hw/arm/raspi.c
@@ -274,6 +274,10 @@ void raspi_base_machine_init(MachineState *machine,
                             &error_abort);
     object_property_set_str(OBJECT(soc), "command-line",
                             machine->kernel_cmdline, &error_abort);
