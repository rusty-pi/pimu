new file mode 100644
index 0000000..60f3f0c
--- /dev/null
+++ b/include/hw/misc/rvf_videocore.h
@@ -0,0 +1,53 @@
+/*
+ * The Raspberry Pi 4 VideoCore, run by the rpi-virt-fw firmware model.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#ifndef HW_MISC_RVF_VIDEOCORE_H
+#define HW_MISC_RVF_VIDEOCORE_H
+
+#include "hw/sysbus.h"
+#include "qemu/thread.h"
+#include "qom/object.h"
+
+#define TYPE_RVF_VIDEOCORE "rvf-videocore"
+OBJECT_DECLARE_SIMPLE_TYPE(RvfVideoCoreState, RVF_VIDEOCORE)
+
+struct rvf_vc;
+
+struct RvfVideoCoreState {
+    SysBusDevice parent_obj;
+
+    /* The ARM's aperture onto the mailbox: 0x40 bytes at 0x7e00b880. */
+    MemoryRegion mbox_mr;
+    qemu_irq mbox_irq;
+    /*
+     * Everything else the ARM may touch in the two peripheral windows and
+     * QEMU has no device for: served by the model's peripherals, or by its
+     * catch-all stub, instead of faulting the guest. Mapped by the SoC under
+     * its own devices (negative priority), so a QEMU model always wins.
+     */
+    MemoryRegion peri_fallback_mr;
+    MemoryRegion peri_low_fallback_mr;
+
+    /* Properties. */
+    char *eeprom;
+    char *sd;
+    char *uart;
+    uint32_t slice;
+
+    /* Links: guest RAM and the VideoCore bus. */
+    MemoryRegion *ram;
+    MemoryRegion *gpu_bus;
+    AddressSpace gpu_as;
+
+    struct rvf_vc *vc;
+    QemuThread thread;
+    bool thread_started;
+    bool stop;
+    int irq_level;
+    bool released;
+    int64_t pace_offset_ns;
+};
+
+#endif
