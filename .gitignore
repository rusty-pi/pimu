/target

# Firmware blobs are fetched by scripts/fetch-firmware.sh, never committed.
/firmware/*
!/firmware/.gitkeep
!/firmware/README.md

# Regression run artifacts.
/testdata/out/
*.actual.txt
docs/*.pdf


# Regenerated by every `scripts/boot-check.sh` run; the assertion is
# testdata/boot/firmware-boot.toml, not this transcript.
/boot.log
/boot.log.console
