/target

# Firmware blobs are fetched by scripts/fetch-firmware.sh, never committed.
/firmware/*
!/firmware/.gitkeep
!/firmware/README.md

# Regression run artifacts.
/testdata/out/
*.actual.txt
docs/*.pdf


# Regenerated by every `boot --scenario` run; the assertion is
# testdata/boot/firmware-boot.toml, not this transcript.
/boot-*.log
/boot-*.log.console
/boot.log
/boot.log.console

# qemu-user core dumps (tests/a64_diff.rs runs with `ulimit -c 0`, but just in case).
qemu_*.core
